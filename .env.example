# 复制此文件为 .env 并填写真实值

# ---- LLM（任意 OpenAI 兼容端点）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-这里填你的key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=500

# ---- OneBot / NapCat 正向 WS ----
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]

# ---- 人格文件（默认指向 D:\DSH\persona-菟菚.md）----
PERSONA_FILE=../persona-菟菚.md
