# 复制此文件为 .env 并填写真实值

# ---- LLM（任意 OpenAI 兼容端点）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-这里填你的key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=500

# ---- OneBot / NapCat 正向 WS ----
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
# 用 aiohttp driver（支持 WS 客户端，能连 NapCat 服务端）
DRIVER=~aiohttp

# ---- 人格文件（项目内，已纳入 git 管理）----
PERSONA_FILE=persona-菟菚.md

# ---- 联网搜索（博查 API 最稳定；SEARCH_ENABLED=0 关闭；SEARCH_ENGINE=bing/ddg 自动回退）----
SEARCH_ENABLED=1
SEARCH_ENGINE=bing
SEARCH_API_KEY=sk-这里填博查的key（可选，填了优先用博查）

# ---- 图片理解（独立视觉模型；不填 VISION_MODEL 则识图关闭）----# 例1 通义千问 VL（DashScope 兼容端点）：
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_API_KEY=sk-你的dashscope-key
# VISION_MODEL=qwen-vl-max
# 例2 硅基流动 Qwen2.5-VL：
# VISION_BASE_URL=https://api.siliconflow.cn/v1
# VISION_API_KEY=sk-你的siliconflow-key
# VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# ---- 主动发消息（逗号分隔可多个 QQ 号，如 10001,10002；留空则对最后说话的人发）----
# PROACTIVE_USER_ID=你的QQ号

# ---- 备选提供方（切换时：注释掉上面的 base_url/model 对应行，取消注释下面一组）----
# 硅基流动 SiliconFlow：https://api.siliconflow.cn/v1（模型如 Qwen/Qwen3-32B、deepseek-ai/DeepSeek-V3）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen3-32B
# 通义千问 DashScope：https://dashscope.aliyuncs.com/compatible-mode/v1（模型如 qwen-plus）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# OpenAI：https://api.openai.com/v1（模型如 gpt-4o-mini）
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
